{
  "name": "base-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "prebuild": "tsx scripts/build-data.ts && tsx scripts/check-links.ts && tsx scripts/og/build-og.tsx",
    "check:links": "tsx scripts/check-links.ts",
    "predev": "tsx scripts/build-data.ts",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-public-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "playwright test -c e2e/playwright.config.ts",
    "screenshots:auth": "playwright test -c e2e/playwright.auth.config.ts",
    "refresh": "tsx scripts/refresh.ts",
    "review": "tsx scripts/review.ts",
    "audit:traction": "tsx scripts/traction-audit.ts",
    "seed:map": "tsx scripts/seed-defillama-map.ts",
    "seed:contracts": "tsx scripts/seed-contracts.ts",
    "seed:venues": "tsx scripts/seed-gecko-dex-map.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check:copy": "node scripts/check-copy.mjs",
    "stock-metadata": "tsx scripts/build-stock-metadata.ts",
    "og": "tsx scripts/og/build-og.tsx"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.55",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "serve": "^14.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
