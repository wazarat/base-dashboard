# Copy to .env.local. None of these are required to build.
# Blockscout API key. Base needs a paid Blockscout plan, so it is unused while CHAIN.blockscoutFree is false (src/lib/chain.ts).
BLOCKSCOUT_API_KEY=
# Optional CoinGecko Demo key, only used as a market-cap fallback.
COINGECKO_DEMO_KEY=
# Tally form share links; the buttons are hidden while these are empty.
NEXT_PUBLIC_TALLY_SUBMIT_URL=
NEXT_PUBLIC_TALLY_CORRECT_URL=
# Set to 1 to build a copy that shows research notes and hand-written lines (admin view). Leave empty for the public site.
NEXT_PUBLIC_SHOW_NOTES=
# Public site URL for canonical links, Open Graph URLs and the sitemap. Production is https://base.canhav.com once the domain is pointed.
NEXT_PUBLIC_SITE_URL=
# Sibling atlases linked from the footer, comma separated. Defaults to robinhood.canhav.com and near.canhav.com.
NEXT_PUBLIC_SIBLING_ATLAS_URLS=https://robinhood.canhav.com,https://near.canhav.com
# Clerk, same production application as canhav.com (added in Milestone 5). The login wall is off while these are empty.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
